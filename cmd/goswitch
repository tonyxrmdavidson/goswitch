#!/usr/bin/env bash
set -euo pipefail

# Resolve repo root (supports symlinks)
SELF="${BASH_SOURCE[0]:-${0}}"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

# --- Load libraries (order matters) ---
# shellcheck source=../lib/common.sh
# shellcheck disable=SC1091
. "$ROOT/lib/common.sh"
# shellcheck source=../lib/brew.sh
# shellcheck disable=SC1091
. "$ROOT/lib/brew.sh"
# shellcheck source=../lib/asdf.sh
# shellcheck disable=SC1091
. "$ROOT/lib/asdf.sh"
# shellcheck source=../lib/tarball.sh
# shellcheck disable=SC1091
. "$ROOT/lib/tarball.sh"

# Version (from repo VERSION file; falls back to dev)
GOSWITCH_VERSION="$(cat "$ROOT/VERSION" 2>/dev/null || echo "dev")"

# --- Local helpers ---
_gs_verify() {
  _gs_has go || {
    _gs_err "go not found on PATH after switch."
    return 1
  }
  go version
}
_is_macos() { [ "$(_gs_os)" = "darwin" ]; }
_is_linux() { [ "$(_gs_os)" = "linux" ]; }

# Non-interactive detection and confirmation
_gs_noninteractive() {
  [ "${GOSWITCH_NONINTERACTIVE:-0}" = "1" ] || [ ! -t 0 ]
}

_gs_confirm() {
  local prompt="${1:-Proceed?}"
  if _gs_noninteractive; then
    return 0
  fi
  if ! read -r -p "$prompt [Y/n] " yn </dev/tty; then
    return 0
  fi
  case "${yn:-Y}" in
    [Yy]*) return 0 ;;
    *) return 1 ;;
  esac
}

usage() {
  cat <<'EOF'
goswitch - switch Go versions with multiple providers

Usage:
  goswitch <1.24|1.24.6>
  goswitch -y <1.22>             # auto-install brew go@<mm> (or 'go' if current series)
  goswitch --brew-install        # interactive install of a missing Homebrew series
  goswitch --asdf-install <ver>  # install via asdf (accepts series like 1.21)
  goswitch --from-mod            # switch to version (or toolchain) from go.mod
  goswitch --list                # list installed brew/asdf/tarball versions
  goswitch --which               # show current go binary and version
  goswitch --tar-install 1.21.13 # (Linux) install official tarball to ~/.local/goversions/<ver>
  goswitch --version             # show goswitch version
  goswitch -h, --help            # show this help
EOF
}

# --- Subcommands ---
_do_from_mod() {
  if [ ! -f go.mod ]; then
    _gs_err "go.mod not found in current directory"
    return 1
  fi
  local ver_line want
  ver_line="$(grep -E '^(toolchain[[:space:]]+go[0-9]+\.[0-9]+(\.[0-9]+)?)|(^go[[:space:]]+[0-9]+\.[0-9]+(\.[0-9]+)?)' go.mod | head -n1 || true)"
  if [ -z "$ver_line" ]; then
    _gs_err "Could not parse Go version from go.mod"
    return 1
  fi
  want="$(echo "$ver_line" | sed -E 's/^toolchain[[:space:]]+//; s/^go[[:space:]]+//; s/^go//')"
  [ -n "$want" ] || {
    _gs_err "Could not parse Go version from go.mod"
    return 1
  }
  exec "$ROOT/cmd/goswitch" "$want"
}

_do_tar_install() {
  local ver="$1"
  if ! _is_linux; then
    _gs_err "--tar-install is intended for Linux"
    return 1
  fi
  if _gs_tar_installed "$ver"; then
    _gs_info "Tarball ${ver} already installed."
  else
    _gs_tar_install "$ver" || return 1
  fi
  _gs_tar_activate "$ver" || return 1
  _gs_info "Using tarball Go ${ver}: $(_gs_verify)"
}

_do_list() {
  if _gs_has brew; then
    _gs_info "Homebrew installed series:"
    _gs_brew_installed_series || true
  else
    _gs_info "Homebrew not found."
  fi
  if _gs_has asdf; then
    _gs_info ""
    _gs_info "asdf installed versions:"
    _gs_asdf_list_versions_clean || true
  else
    _gs_info ""
    _gs_info "asdf not found."
  fi
  if _is_linux; then
    _gs_info ""
    _gs_info "tarball installs (in ~/.local/goversions):"
    _gs_tar_list_installed || true
  fi
}

_do_which() {
  if _gs_has go; then
    printf "Go binary: %s\n" "$(command -v go)"
    _gs_verify
  else
    _gs_err "go not found on PATH."
    return 1
  fi
}

main() {
  local auto_yes=0 subcmd="" req="" mm="" tarver=""

  # Parse args
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes) auto_yes=1; shift ;;
      --brew-install|--installer) subcmd="brew-install"; shift ;;
      --asdf-install) subcmd="asdf-install"; shift; req="${1:-}"; [ -z "$req" ] && { _gs_err "Need version (e.g. 1.21)"; exit 1; }; shift ;;
      --tar-install) subcmd="tar-install"; shift; tarver="${1:-}"; [ -z "$tarver" ] && { _gs_err "Need a version, e.g. 1.21.13"; exit 1; }; shift ;;
      --from-mod) subcmd="from-mod"; shift ;;
      --list) subcmd="list"; shift ;;
      --which) subcmd="which"; shift ;;
      --version) echo "goswitch ${GOSWITCH_VERSION}"; exit 0 ;;
      -h|--help) usage; exit 0 ;;
      *) req="$1"; shift ;;
    esac
  done

  case "$subcmd" in
    brew-install) goswitch_brew_install; exit $? ;;
    asdf-install) goswitch_asdf_install "$req"; exit $? ;;
    tar-install) _do_tar_install "$tarver"; exit $? ;;
    from-mod) _do_from_mod; exit $? ;;
    list) _do_list; exit 0 ;;
    which) _do_which; exit $? ;;
  esac

  [ -z "${req:-}" ] && { usage; exit 1; }

  mm="$(_gs_mm "$req")"
  case "$mm" in ''|*[!0-9.]*)
    _gs_err "Version must look like 1.22 or 1.22.3"; exit 1 ;;
  esac

  local have_brew=0 have_asdf=0
  _gs_has brew && have_brew=1
  _gs_has asdf && have_asdf=1

  if _is_macos; then
    # macOS precedence: Brew → asdf
    if [ "$have_brew" -eq 1 ]; then
      if brew list --versions "go@${mm}" >/dev/null 2>&1 || brew list --versions go >/dev/null 2>&1; then
        if _gs_activate_brew_series "$mm"; then
          _gs_info "Using Homebrew go@${mm}: $(_gs_verify)"; exit 0
        fi
      fi
      if _gs_brew_series_available "$mm"; then
        if [ "$auto_yes" -eq 1 ] || _gs_noninteractive; then
          _gs_info "Installing go@${mm} via Homebrew..."
          if brew install "go@${mm}" && _gs_activate_brew_series "$mm"; then
            _gs_info "Using Homebrew go@${mm}: $(_gs_verify)"; exit 0
          fi
        else
          _gs_info "Homebrew go@${mm} is not installed."
          if _gs_confirm "Install go@${mm} now via Homebrew?"; then
            if brew install "go@${mm}" && _gs_activate_brew_series "$mm"; then
              _gs_info "Using Homebrew go@${mm}: $(_gs_verify)"; exit 0
            fi
          fi
        fi
      fi
    fi
    if [ "$have_asdf" -eq 1 ]; then
      if _gs_asdf_list_versions_clean | grep -qx "$req"; then
        _gs_activate_asdf_version "$req" && { _gs_info "Using asdf golang $req: $(_gs_verify)"; exit 0; }
      fi
      local match="$(_gs_asdf_list_versions_clean | grep -E "^${mm}(\.|$)" | sort -V | tail -n1 || true)"
      if [ -n "$match" ]; then
        _gs_activate_asdf_version "$match" && { _gs_info "Using asdf golang $match (series ${mm}.x): $(_gs_verify)"; exit 0; }
      fi
      if [ "$auto_yes" -eq 1 ] || _gs_noninteractive; then
        goswitch_asdf_install "$req" && exit 0
      else
        if _gs_confirm "asdf golang ${req} is not installed. Install via asdf now?"; then
          goswitch_asdf_install "$req" && exit 0
        fi
      fi
    fi
    _gs_err "Could not activate Go ${req}."
    [ "$have_asdf" -eq 1 ] && _gs_info "Tip: goswitch --asdf-install ${req}"
    exit 1
  fi

  if _is_linux; then
    # Linux precedence: asdf → Brew → Tarball
    if [ "$have_asdf" -eq 1 ]; then
      if _gs_asdf_list_versions_clean | grep -qx "$req"; then
        _gs_activate_asdf_version "$req" && { _gs_info "Using asdf golang $req: $(_gs_verify)"; exit 0; }
      fi
      local match="$(_gs_asdf_list_versions_clean | grep -E "^${mm}(\.|$)" | sort -V | tail -n1 || true)"
      if [ -n "$match" ]; then
        _gs_activate_asdf_version "$match" && { _gs_info "Using asdf golang $match (series ${mm}.x): $(_gs_verify)"; exit 0; }
      fi
      if [ "$auto_yes" -eq 1 ] || _gs_noninteractive; then
        goswitch_asdf_install "$req" && exit 0
      else
        if _gs_confirm "asdf golang ${req} is not installed. Install via asdf now?"; then
          goswitch_asdf_install "$req" && exit 0
        fi
      fi
    fi
    if [ "$have_brew" -eq 1 ]; then
      if brew list --versions "go@${mm}" >/dev/null 2>&1 || brew list --versions go >/dev/null 2>&1; then
        if _gs_activate_brew_series "$mm"; then
          _gs_info "Using Homebrew go@${mm}: $(_gs_verify)"; exit 0
        fi
      fi
      if _gs_brew_series_available "$mm"; then
        if [ "$auto_yes" -eq 1 ] || _gs_noninteractive; then
          _gs_info "Installing go@${mm} via Homebrew..."
          if brew install "go@${mm}" && _gs_activate_brew_series "$mm"; then
            _gs_info "Using Homebrew go@${mm}: $(_gs_verify)"; exit 0
          fi
        else
          _gs_info "Homebrew go@${mm} is not installed."
          if _gs_confirm "Install go@${mm} now via Homebrew?"; then
            if brew install "go@${mm}" && _gs_activate_brew_series "$mm"; then
              _gs_info "Using Homebrew go@${mm}: $(_gs_verify)"; exit 0
            fi
          fi
        fi
      fi
    fi
    if _gs_tar_installed "$req"; then
      _gs_tar_activate "$req" && { _gs_info "Using tarball Go ${req}: $(_gs_verify)"; exit 0; }
    fi
    local exact_tar="$(_gs_tar_best_match_in_series "$mm" || true)"
    if [ -n "$exact_tar" ]; then
      _gs_tar_activate "$exact_tar" && { _gs_info "Using tarball Go ${exact_tar} (series ${mm}.x): $(_gs_verify)"; exit 0; }
    fi
    _gs_info "No tarball install for ${req} found under ~/.local/goversions."
    if [ "$auto_yes" -eq 1 ] || _gs_noninteractive || _gs_confirm "Download and install official tarball for ${req} now?"; then
      if _gs_tar_install "$req" && _gs_tar_activate "$req"; then
        _gs_info "Using tarball Go ${req}: $(_gs_verify)"; exit 0
      fi
    fi
    _gs_err "Could not activate Go ${req} on Linux."
    _gs_info "Tips: goswitch --asdf-install ${req} | goswitch --tar-install ${req}"
    exit 1
  fi

  _gs_err "Unsupported OS: $(_gs_os)"
  exit 1
}

main "$@"
